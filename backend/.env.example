# Local SQL Server / SQL Server Express with TCP/IP and SQL authentication enabled.
# Run SSMS as administrator and execute backend/db/00-create-database.sql first.
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=VeriDraw
SQL_USER=veridraw_app
SQL_PASSWORD=REPLACE_WITH_YOUR_SQL_LOGIN_PASSWORD
# Encrypt on; local self-signed cert exception ONLY. In production set TRUST=false.
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
VRF_PRIVATE_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS_FROM_KEYS_GENERATE
ADMIN_EMAIL=organizer@example.test
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
ENABLE_DEMO=true
