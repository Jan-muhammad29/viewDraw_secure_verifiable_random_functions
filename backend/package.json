{
  "name": "@veridraw/backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:create": "node scripts/create-database.mjs",
    "db:wait": "node scripts/wait-for-sql.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:admin": "node scripts/create-admin.mjs",
    "keys:generate": "node scripts/generate-key.mjs"
  },
  "dependencies": {
    "@veridraw/protocol": "0.5.0",
    "@collectorcrypt/ecvrf": "0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mssql": "^12.8.0",
    "express-rate-limit": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/mssql": "^12.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
